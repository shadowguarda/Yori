<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by every bottom sheet: expressive top corners, soft sheen and a specular hairline (glass look) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/expressive_corner_large"
                android:topRightRadius="@dimen/expressive_corner_large" />
            <solid android:color="?attr/colorBackgroundFloating" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/expressive_corner_large"
                android:topRightRadius="@dimen/expressive_corner_large" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#26FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/expressive_corner_large"
                android:topRightRadius="@dimen/expressive_corner_large" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
